<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/replacement_image_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_text"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Hướng xoay ảnh (Quan trọng cho TikTok / Zalo):"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Nếu vào TikTok/Zalo thấy camera bị xoay ngang 90°, hãy chọn '270°'!"
            android:textSize="12sp"
            android:textColor="#C62828"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/radioGroupRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radioRotate270"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="270° (Khuyên dùng cho TikTok/Zalo - Sửa lỗi xoay 90°)"
                android:checked="true"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radioRotate0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0° (Gốc - Không xoay)" />

            <RadioButton
                android:id="@+id/radioRotate90"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="90° (Xoay phải 90° theo chiều KĐH)" />

            <RadioButton
                android:id="@+id/radioRotate180"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="180° (Lộn ngược 180°)" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scale_mode_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupScaleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radioScaleCenterCrop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scale_center_crop"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioScaleStretch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scale_stretch" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtDetectedResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Độ phân giải tự động: Đang chờ nhận diện..."
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_image" />

        <TextView
            android:id="@+id/txtImageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_status"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtVideoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_status"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtPreviewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁️ Xem trước ảnh thay thế hiện tại:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp"
            android:background="#15000000"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp">

                <Switch
                    android:id="@+id/switch1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/switch1" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp">

                <Switch
                    android:id="@+id/switch2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/switch2" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp">

                <Switch
                    android:id="@+id/switch3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/switch3" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp">

                <Switch
                    android:id="@+id/switch4"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/switch4" />
            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="48dp">

                <Switch
                    android:id="@+id/switch5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minHeight="48dp"
                    android:text="@string/switch5" />
            </TableRow>

        </TableLayout>
    </LinearLayout>
</ScrollView>
